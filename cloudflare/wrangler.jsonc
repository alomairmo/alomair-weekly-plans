{
  "name": "namthaja-lesson-plan-test",
  "main": "./dist/worker.js",
  "build": {
    "command": "node cloudflare/build-worker.mjs"
  },
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "namthaja.app/Lesson-Plan*",
      "zone_id": "8ad5b066e68029339eca0ebd6933c8ca"
    }
  ],
  "assets": {
    "directory": "../dist/public",
    "binding": "ASSETS",
    "base_path": "/Lesson-Plan",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/Lesson-Plan/api/*"]
  }
}
